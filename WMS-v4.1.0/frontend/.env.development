# =============================================================================
# 开发环境配置（WMS-v4：真实后端，无 mock）
# =============================================================================

VITE_APP_TITLE=仓库拣货与波次管理系统

# v4 已彻底移除前端 mock，固定走真实后端
VITE_USE_MOCK=false

# 接口基础路径，由 Vite 代理转发到 http://127.0.0.1:8080
VITE_API_BASE_URL=/api

# 请求超时（毫秒）
VITE_REQUEST_TIMEOUT=15000