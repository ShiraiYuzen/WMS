# =============================================================================
# 开发环境配置
# =============================================================================

# 应用标题
VITE_APP_TITLE=仓库拣货与波次管理系统

# -----------------------------------------------------------------------------
# 是否使用前端 Mock 数据
#
#   true  —— 前端自带模拟数据，无需启动后端即可跑通全部页面（当前默认）
#   false —— 走真实后端接口，Vite 会把 /api 代理到 http://localhost:8080
#
# 后端接好数据库后，把这里改成 false 即可，业务代码一行都不用动。
# -----------------------------------------------------------------------------
VITE_USE_MOCK=true

# 接口基础路径。走 mock 时该值仅用于展示；走真实后端时由 Vite 代理转发
VITE_API_BASE_URL=/api

# 请求超时（毫秒）
VITE_REQUEST_TIMEOUT=15000
