# =============================================================================
# 生产环境配置
# =============================================================================

VITE_APP_TITLE=仓库拣货与波次管理系统

# 生产环境固定走真实后端
VITE_USE_MOCK=false

# 生产环境接口前缀。若前后端同域部署保持 /api；
# 若跨域部署改成完整地址，例如 https://wms-api.example.com/api
VITE_API_BASE_URL=/api

VITE_REQUEST_TIMEOUT=20000
